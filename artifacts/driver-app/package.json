{
  "name": "@workspace/driver-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'if [ -z \"$EXPO_TOKEN\" ] && [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "validate:production-export": "node scripts/build.js --validate-production-export",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:offline-queue": "node --experimental-strip-types --test lib/offline-queue-migration.test.mjs lib/stop-report.test.ts lib/file-backed-store.test.ts lib/pwa-worker.test.cjs",
    "test:mobile": "node --experimental-strip-types --test lib/mobile-invariants.test.mjs lib/tracking-lifecycle.test.mjs lib/route-selection.test.mjs lib/next-stop.test.ts lib/signature-image.test.mjs lib/work-execution.test.mjs lib/offline-session.test.mjs lib/session-verification.test.mjs lib/report-failure-reason.test.ts lib/handoff-cache.test.ts lib/driver-link.test.ts lib/route-identity.test.ts lib/report-category-cache.test.ts lib/message-display.test.ts",
    "test:i18n": "node --experimental-strip-types --test lib/error-localizer.test.mjs lib/gps-errors.test.mjs lib/i18n-catalog.test.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/ngrok": "^4.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.90.21",
    "@types/leaflet": "^1.9.21",
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "create-launch": "0.4.1",
    "expo": "~58.0.22",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "fast-png": "^8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "^1.22.7",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "zod": "catalog:",
    "zod-validation-error": "^5.0.0"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "expo-file-system": "^58.0.13",
    "expo-notifications": "^58.1.7",
    "leaflet": "^1.9.4",
    "react-native-maps": "1.29.11"
  }
}
